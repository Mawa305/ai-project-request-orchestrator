{
  "name": "Project Request Orchestrator",
  "nodes": [
    {
      "id": "37a42f71-4824-4082-a47d-f714a18c27ed",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        300
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "project-request",
        "responseMode": "responseNode",
        "options": {}
