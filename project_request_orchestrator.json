        "sendTo": "={{ $('Parse QA').first().json.email }}",
        "subject": "=Update on your request {{ $('Parse QA').first().json.requestId }}",
        "emailType": "text",
        "message": "={{ $json.Status === 'APPROVED' ? 'Hi ' + $('Parse QA').first().json.name + ',\\n\\nYour proposal is ready:\\n\\n' + $('Parse QA').first().json.proposal.summary : 'Hi ' + $('Parse QA').first().json.name + ',\\n\\nYour request is under review. Our team will contact you shortly.' }}"
      },
