    {
      "id": "d6075148-205a-47ca-b922-6a8f488f9d99",
      "name": "Parse QA",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2640,
        300
      ],
      "parameters": {
        "jsCode": "\nconst res = $input.first().json;\nconst base = $('Parse Proposal').first().json;\nlet qa = { approved: false, feedback: 'QA response could not be parsed.' };\ntry { qa = JSON.parse(res.output); } catch (e) {}\nconst qaApproved = qa.approved === true;\nconst readyForReview = qaApproved || base.revisions >= 2;\nconst needsApproval = base.budget > 1000 || base.proposal.estimated_price > 1000 || base.proposal.failed === true || !qaApproved;\nreturn [{ json: {\n  ...base,\n  qaApproved,\n  readyForReview,\n  needsApproval,\n  feedback: String(qa.feedback || ''),\n  revisions: readyForReview ? base.revisions : base.revisions + 1\n} }];\n"
      }
    },
