    {
      "id": "b464f304-e1ce-4bee-9154-d5d838f7c56a",
      "name": "Read Approval",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3600,
        300
      ],
      "parameters": {
        "jsCode": "\nconst d = $input.first().json;\nconst approved = (d.data && (d.data.approved === true || d.data.approved === 'true')) || d.approved === true || d.approved === 'true';\nconst base = $('Parse QA').first().json;\nreturn [{ json: { ...base, status: approved ? 'APPROVED' : 'REJECTED', approvedBy: approved ? 'human' : 'declined' } }];\n"
      }
    },
    {
      "id": "78390779-ec04-4225-a86c-ad3923ae98e2",
